# llama.cpp binaries on a mesa userspace the host's Venus renderer supports.
#
# Both images ship a virtio ICD, so the choice is not about which one has the
# file. A mesa newer than the host renderer enumerates no Vulkan device at all,
# and neither the loader nor the driver reports why. Take mesa from ramalama and
# only the binaries from llama.cpp.
#
# Bumping the llama.cpp pin is safe because mesa does not move with it. Bumping
# the ramalama pin moves mesa, so re-check Venus on a real worker first.
FROM ghcr.io/ggml-org/llama.cpp:server-vulkan@sha256:4bba991a7ec5aa1ce73c1b1b06154589169f93e49f730836a6a2d25bd6d017e0 AS llama

FROM quay.io/ramalama/ramalama@sha256:abe07beba518d6864738a67af8ea3511cdaa4b24efb197740967d0d8e19419e4

COPY --from=llama /app /app

# ramalama releases far less often than llama.cpp, so its bundled binaries fall
# behind the models people want to serve. Drop the stale ones and publish the
# overlaid binaries under the paths the recipes call, so nothing resolves to a
# mixed pair of builds.
RUN rm -f /usr/bin/llama /usr/bin/llama-* \
    && for binary in /app/llama /app/llama-*; do \
         [ -x "${binary}" ] || continue; \
         ln -s "${binary}" "/usr/bin/$(basename "${binary}")"; \
       done \
    && /usr/bin/llama-server --version

ENV LLAMA_ARG_HOST=0.0.0.0

WORKDIR /app
ENTRYPOINT ["/app/llama-server"]
